# Copy to .env for local work. Never commit .env.
# With every provider key blank the app still runs: manual product entry and assisted rooms work.

ROOMSET_ENV=dev

# Local default is SQLite. In production use Postgres (Supabase pooler URL).
DATABASE_URL=sqlite:///./data/roomset.db

# local | s3. The free Render disk is wiped on each restart, so production needs s3.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/artifacts
S3_ENDPOINT_URL=
S3_BUCKET=roomset
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Providers. Keys stay on the server.
BASETEN_API=
BASETEN_MODEL=meta-models/muse-spark-open-1026
MUSE_API=

# local = trimesh on this machine (free, CPU). modal = Blender on Modal.
SCENE_BUILDER=local
MODAL_APP_NAME=roomset-worker
# Modal SDK reads these two.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Limits
MAX_CONCURRENT_JOBS=2
MAX_RENDERS_PER_SESSION=10
RETENTION_DAYS=7
